# Database Configuration
# Option A: Single DATABASE_URL (preferred for cloud)
# DATABASE_URL="mysql://username:password@localhost:3306/igymcare?charset=utf8mb4"

# Option B: Host/port credentials (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=igymcare
DB_PASSWORD=igymcare
DB_DATABASE=igymcare

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRATION=30d

# Application Configuration
APP_PORT=3000
APP_HOST=localhost
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# WebSocket Configuration
WS_PORT=3000

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
